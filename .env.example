# SortMyPlate Environment Configuration

# Project & Security
PROJECT_NAME=SortMyPlate
VERSION=1.0.0
SECRET_KEY=sortmyplate-ultra-secure-key-256bit-aes-gcm-master-key-2026

# Database Configuration:
# 1) Default Local Zero-Setup (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./sortmyplate.db

# 2) Production PostgreSQL (Docker or Cloud AWS RDS / GCP Cloud SQL / Supabase):
# DATABASE_URL=postgresql+asyncpg://sortmyplate_admin:super_secure_dev_password_2026@localhost:5432/sortmyplate_db

# Google Sign-In
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# LLM Provider: "mock", "deepseek", "claude", or "openai"
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
